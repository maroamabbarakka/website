rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function adminDoc() {
      return get(/databases/$(database)/documents/adminUsers/$(request.auth.uid));
    }

    function activeAdmin() {
      return signedIn() && adminDoc().data.active == true;
    }

    function hasRole(role) {
      return activeAdmin() && adminDoc().data.role == role;
    }

    function canEditContent() {
      return activeAdmin() && adminDoc().data.role in ['superadmin', 'editor'];
    }

    function canHandleLeads() {
      return activeAdmin() && adminDoc().data.role in ['superadmin', 'sales'];
    }

    function isSuperadmin() {
      return activeAdmin() && adminDoc().data.role == 'superadmin';
    }

    // Site Settings: Publik membaca profil publik perusahaan, hanya superadmin/editor yang dapat mengedit
    match /siteSettings/{id} {
      allow read: if true;
      allow write: if isSuperadmin();
    }

    // Projects: Publik hanya membaca proyek yang berstatus isPublished == true
    match /projects/{id} {
      allow read: if resource.data.isPublished == true || canEditContent();
      allow create, update: if canEditContent();
      allow delete: if isSuperadmin();
    }

    // Services: Publik hanya membaca layanan yang berstatus isPublished == true
    match /services/{id} {
      allow read: if resource.data.isPublished == true || canEditContent();
      allow write: if canEditContent();
    }

    // Insights/Articles: Publik hanya membaca status == 'published'
    match /insights/{id} {
      allow read: if resource.data.status == 'published' || canEditContent();
      allow write: if canEditContent();
    }

    // Leads: Tidak ada public read/list/delete.
    // Sales dan Superadmin dapat membaca dan memperbarui status/catatan tindak lanjut.
    // Public create hanya diizinkan dengan whitelist kunci eksplisit (hasOnly) & validasi tipe/ukuran ketat.
    match /leads/{id} {
      allow read, update: if canHandleLeads();
      allow delete: if isSuperadmin();
      allow create: if request.resource.data.keys().hasAll(['fullName', 'email', 'serviceType', 'message', 'consent'])
        && request.resource.data.keys().hasOnly([
          'fullName', 'email', 'phone', 'companyOrganization', 'serviceType',
          'projectBudget', 'projectTimeline', 'message', 'consent', 'consentTextVersion',
          'status', 'sourcePath', 'targetOfficialEmail', 'targetOfficialPhone',
          'createdAt', 'serverTimestamp'
        ])
        && request.resource.data.fullName is string && request.resource.data.fullName.size() >= 2 && request.resource.data.fullName.size() <= 100
        && request.resource.data.email is string && request.resource.data.email.matches('^[^@]+@[^@]+\\.[^@]+$') && request.resource.data.email.size() <= 254
        && request.resource.data.serviceType in ['events', 'multimedia', 'digital', 'integrated', 'other']
        && request.resource.data.message is string && request.resource.data.message.size() >= 10 && request.resource.data.message.size() <= 3000
        && request.resource.data.consent == true
        && (!('status' in request.resource.data) || request.resource.data.status == 'new')
        && (!('phone' in request.resource.data) || request.resource.data.phone == null || (request.resource.data.phone is string && request.resource.data.phone.size() <= 35))
        && (!('companyOrganization' in request.resource.data) || request.resource.data.companyOrganization == null || (request.resource.data.companyOrganization is string && request.resource.data.companyOrganization.size() <= 150))
        && (!('projectBudget' in request.resource.data) || request.resource.data.projectBudget == null || (request.resource.data.projectBudget is string && request.resource.data.projectBudget.size() <= 100))
        && (!('projectTimeline' in request.resource.data) || request.resource.data.projectTimeline == null || (request.resource.data.projectTimeline is string && request.resource.data.projectTimeline.size() <= 100))
        && (!('consentTextVersion' in request.resource.data) || (request.resource.data.consentTextVersion is string && request.resource.data.consentTextVersion.size() <= 50))
        && (!('sourcePath' in request.resource.data) || (request.resource.data.sourcePath is string && request.resource.data.sourcePath.size() <= 100))
        && (!('createdAt' in request.resource.data) || request.resource.data.createdAt is string);
    }

    // Admin Users: Hanya superadmin atau diri sendiri yang membaca data profil admin sendiri
    match /adminUsers/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isSuperadmin());
      allow write: if isSuperadmin();
    }

    // Audit Logs: Hanya superadmin yang dapat membaca, hanya server / superadmin yang mencatat
    match /auditLogs/{id} {
      allow read: if isSuperadmin();
      allow create: if activeAdmin();
      allow update, delete: if false;
    }

    // Deny by default untuk seluruh koleksi lain
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
