rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function isStaffEditor() {
      return request.auth != null
        && firestore.get(/databases/(default)/documents/adminUsers/$(request.auth.uid)).data.active == true
        && firestore.get(/databases/(default)/documents/adminUsers/$(request.auth.uid)).data.role in ['superadmin', 'editor'];
    }

    // Media publik (portfolio, artikel): read publik diizinkan, upload hanya untuk editor/superadmin terverifikasi
    match /portfolio/{allPaths=**} {
      allow read: if true;
      allow write: if isStaffEditor()
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|webp|avif)');
    }

    match /media/{allPaths=**} {
      allow read: if true;
      allow write: if isStaffEditor()
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|webp|avif)');
    }

    // Direktori privat: tolak semua akses publik
    match /private/{allPaths=**} {
      allow read, write: if false;
    }

    // Deny by default
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
