rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Media publik (portfolio, artikel): read publik diizinkan, upload dibatasi staf terotentikasi, ukuran berkas < 10MB, dan tipe MIME gambar valid
    match /portfolio/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|webp|avif)');
    }

    match /media/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|webp|avif)');
    }

    // Direktori privat: tolak semua akses publik
    match /private/{allPaths=**} {
      allow read, write: if false;
    }

    // Deny by default
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
