# Konfigurasi Publik Firebase Client
NEXT_PUBLIC_FIREBASE_API_KEY=your-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=maroa-web-prod.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=maroa-web-prod
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=maroa-web-prod.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
NEXT_PUBLIC_FIREBASE_APP_ID=your-app-id
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX

# Firebase App Check (reCAPTCHA Enterprise Site Key)
NEXT_PUBLIC_RECAPTCHA_ENTERPRISE_SITE_KEY=your-recaptcha-site-key

# URL Dasar Situs (digunakan untuk Canonical & OpenGraph Metadata)
NEXT_PUBLIC_SITE_URL=https://maroa.co.id

# Status Environment: development / staging / production
NEXT_PUBLIC_APP_ENV=development
